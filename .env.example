# GlucoPredict · variables de entorno (SIN valores reales). Copia a .env.local para desarrollo.
# En Vercel: marca Production Y Preview, y haz Redeploy después de cambiar variables.
# En el valor va SOLO el valor: sin comillas, sin paréntesis, sin comentarios.

# ---- Público ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "true" solo tras cerrar los gates legales/IP (por defecto todo queda noindex)
ALLOW_INDEXING=false

# ---- Monetización ----
# validation (por defecto): el informe completo se envía gratis por email (fase de validación del PRD)
# paypal: vista previa borrosa por email + desbloqueo de pago (requiere PayPal + Resend + REPORT_TOKEN_SECRET + PURCHASE_STORAGE=stateless o Supabase)
MONETIZATION_MODE=validation
# Hipótesis preliminar de spec/monetizacion.json (US: USD 9). Solo se fija en el servidor.
REPORT_PRICE_USD=9.00

# ---- Correo (Resend) ----
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=GlucoPredict <info@midominio.com>
# SOLO la dirección. Recibe avisos de solicitudes y el "VENTA CONFIRMADA".
OWNER_EMAIL=info@midominio.com
# Opcional: otro buzón para el aviso de venta (por defecto OWNER_EMAIL)
GLUCOPREDICT_ADMIN_EMAIL=

# ---- Secretos propios (openssl rand -base64 48) ----
# >= 32 caracteres. Cifra enlaces de desbloqueo y payloads. Si cambia, los enlaces anteriores dejan de abrir.
REPORT_TOKEN_SECRET=replace_with_48_random_bytes_base64
CRON_SECRET=replace_with_random_16_plus_chars
REPORT_RETENTION_DAYS=30

# ---- Dónde viven las compras ----
# stateless = SIN base de datos y sin costo (PayPal es el libro contable; ver docs/PAYPAL_SETUP.md §1).
# Vacío = usa Supabase si está configurado.
PURCHASE_STORAGE=stateless

# ---- Supabase (opcional; solo servidor) ----
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_value

# ---- PayPal (Orders v2) ----
# sandbox por defecto. LIVE exige PAYPAL_ENV=live Y PAYMENTS_LIVE_APPROVED=true (doble interruptor).
PAYPAL_ENV=sandbox
PAYMENTS_LIVE_APPROVED=false
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me
# Recomendado: se verifica en cada captura
PAYPAL_MERCHANT_ID=

# ---- Pendiente de implementar (ver DECISIONS.md) ----
# Google Drive loader, Turnstile, PostHog, Sentry, /admin: variables reservadas en el PRD, aún no usadas.
