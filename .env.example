# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monetization: validation | stripe
MONETIZATION_MODE=validation

# Operations
OWNER_EMAIL=owner@example.invalid
ADMIN_EMAILS=admin@example.invalid

# Supabase (server + public auth client)
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_value
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_public_anon_key

# Google Drive service account
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=replace_with_folder_id
GOOGLE_DRIVE_ROOT_PATH=/Apps/glucopredict/
DRIVE_CACHE_TTL_SECONDS=86400

# Email
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=GlucoPredict <reports@example.invalid>

# Report/privacy cryptography
REPORT_TOKEN_SECRET=replace_with_32_plus_random_bytes
HEALTH_DATA_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_site_key
TURNSTILE_SECRET_KEY=replace_with_secret_key

# Analytics / errors
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=replace_only_in_ci_if_source_maps_are_uploaded

# Stripe: only used when MONETIZATION_MODE=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_REPORT_USD=price_replace_me
