    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
